# Sao chép thành code/.env (KHÔNG commit .env) rồi điền giá trị thật.
# Endpoint OpenAI-compatible. Kiểm tên model chính xác bằng lệnh liệt kê model.

# Cách 1 — FPT AI Marketplace (key tạo ở marketplace.fptcloud.com, nhớ cấp quyền model vision cho key)
VLM_API_BASE=https://mkp-api.fptcloud.com/v1
VLM_API_KEY=
VLM_MODEL=Qwen2.5-VL-7B-Instruct

# Cách 2 — OpenRouter (key tạo ở openrouter.ai, mục Keys; bản :free có giới hạn lượt gọi)
# VLM_API_BASE=https://openrouter.ai/api/v1
# VLM_API_KEY=
# VLM_MODEL=qwen/qwen2.5-vl-32b-instruct:free
